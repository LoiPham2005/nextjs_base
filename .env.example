# =============================================================================
# Copy file này thành `.env` rồi điền giá trị thật. KHÔNG commit `.env`.
# Mọi biến dưới đây được validate bằng Zod trong `src/lib/env.ts`:
# thiếu hoặc sai định dạng thì app fail ngay lúc khởi động, không phải lúc
# request đầu tiên chạm tới nó.
# =============================================================================

# --- Bắt buộc -----------------------------------------------------------------

# Chuỗi kết nối PostgreSQL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nextjs_prisma_base?schema=public"

# Khoá ký session cookie (HS256). Tối thiểu 32 ký tự.
# Sinh khoá mới:  openssl rand -base64 48
SESSION_SECRET="thay-bang-chuoi-ngau-nhien-toi-thieu-32-ky-tu-xxxxx"

# --- Tuỳ chọn -----------------------------------------------------------------

# Kết nối trực tiếp, bỏ qua connection pooler (Neon / Supabase / PgBouncer).
# Prisma Migrate cần kết nối trực tiếp; runtime thì dùng DATABASE_URL.
# DIRECT_DATABASE_URL="postgresql://..."

# Số ngày cookie session trên web còn hiệu lực (mặc định 7).
# SESSION_MAX_AGE_DAYS=7

# --- Token cho client mobile (REST API) ---------------------------------------
# Access token là JWT nên KHÔNG thu hồi được; hạn ngắn chính là thứ giới hạn
# thiệt hại khi token bị lộ. Việc giữ đăng nhập lâu dài do refresh token lo,
# và refresh token nằm trong database nên xoá là mất hiệu lực ngay.
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30

# Tài khoản admin do `pnpm db:seed:prod` tạo ra.
# Bắt buộc phải set khi seed ở môi trường production.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="doi-mat-khau-nay-truoc-khi-len-production"

# --- Xác thực email & đặt lại mật khẩu ----------------------------------------
# Hạn của link trong email. Hai mốc khác nhau vì mức thiệt hại khác nhau: link
# xác thực bị lộ chỉ giúp kẻ khác xác nhận hộ một địa chỉ, còn link đặt lại mật
# khẩu bị lộ là mất tài khoản.
# EMAIL_VERIFICATION_TTL_HOURS=24
# PASSWORD_RESET_TTL_MINUTES=60

# Địa chỉ người gửi trên email hệ thống.
MAIL_FROM="no-reply@example.com"

# ⚠️ NEXT_PUBLIC_APP_URL ở trên là BẮT BUỘC khi bật các luồng email: link trong
# thư được dựng từ nó. Thiếu thì việc gửi thư sẽ ném lỗi ngay thay vì gửi đi một
# email chứa link localhost — thư đã gửi thì không rút lại được.
#
# Gửi thư thật: viết một object thoả interface `Mailer` (src/lib/mailer.ts) rồi
# gọi setMailer() lúc khởi động. Bộ khung cố tình không chọn sẵn nhà cung cấp.
# Ở môi trường dev, nội dung email được ghi ra log — lấy link trong đó mà test.

# URL công khai của app, dùng cho redirect và metadata.
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Realtime (WebSocket) -----------------------------------------------------
# Tiến trình riêng: `pnpm realtime:dev`. Xem thư mục realtime/.
# SESSION_SECRET ở trên dùng chung — token web/mobile phải verify được ở đây.
# REALTIME_PORT=3002
# REALTIME_CORS_ORIGIN="http://localhost:3000"

# Bỏ trống = chạy một instance. BẮT BUỘC từ instance thứ hai trở đi: thiếu nó
# thì client nối vào máy A không nhận được tin phát từ máy B, và không có lỗi nào.
# REDIS_URL="redis://localhost:6379"

# --- Chống brute-force theo tài khoản ------------------------------------------
# Bổ sung cho rate-limit theo IP: cặp này chặn nhiều IP cùng dò một tài khoản.
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15

# --- Đăng nhập mạng xã hội (OAuth) ---------------------------------------------
# Mỗi provider độc lập và tuỳ chọn — thiếu cặp ID/SECRET của provider nào thì
# nút đăng nhập của provider đó tự ẩn/báo lỗi, không làm sập app.
# Redirect URI cần khai báo phía provider: <NEXT_PUBLIC_APP_URL>/api/auth/oauth/<provider>/callback

# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# FACEBOOK_CLIENT_ID=""
# FACEBOOK_CLIENT_SECRET=""

# Apple không có client secret tĩnh — đây là nguyên liệu để tự ký JWT làm secret
# lúc chạy (xem src/lib/oauth/apple-client-secret.ts). APPLE_PRIVATE_KEY là nội
# dung file .p8 tải từ Apple Developer, giữ nguyên xuống dòng (\n).
# APPLE_CLIENT_ID=""
# APPLE_TEAM_ID=""
# APPLE_KEY_ID=""
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
