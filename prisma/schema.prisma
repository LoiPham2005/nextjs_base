generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  // Bỏ comment khi chạy sau connection pooler (PgBouncer, Neon, Supabase).
  // Prisma Migrate cần kết nối trực tiếp; runtime vẫn dùng url ở trên.
  // directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id String @id @default(cuid())

  email String @unique

  /// Bcrypt hash. Null nghĩa là tài khoản chưa đặt mật khẩu (được tạo bởi
  /// admin, hoặc đăng nhập qua OAuth) — khác hẳn với chuỗi rỗng, vốn là một
  /// mật khẩu "hợp lệ" nhìn từ phía tầng dữ liệu.
  password String?

  name String?
  role Role   @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Trang danh sách sắp xếp theo createdAt desc; không có index thì mỗi lần
  // mở trang là một lần full table scan + sort.
  @@index([createdAt])
  @@map("users")
}
