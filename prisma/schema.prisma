generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique // Định danh cố định (VD: ADMIN)
  name        String   // Tên hiển thị
  description String?
  isSystem    Boolean  @default(false) // Không thể xóa/đổi key nếu là true

  permissions RolePermission[]
  users       User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // Khớp với hằng trong PERMISSIONS (VD: user:read)
  description String?

  roles       RolePermission[]

  createdAt   DateTime @default(now())

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

enum UserStatus {
  ACTIVE
  BANNED
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  password           String?             // Bcrypt hash (null nếu đăng nhập OAuth/chưa đặt)
  username           String?             @unique // Lưu dạng lowercase
  fullName           String?             // Tên hiển thị đầy đủ
  roleId             String
  role               Role                @relation(fields: [roleId], references: [id])
  emailVerifiedAt    DateTime?           // Thời điểm xác thực email
  status             UserStatus          @default(ACTIVE) // Khoá tài khoản do admin (BANNED) — thủ công, không tự hết hạn
  failedLoginAttempts Int                @default(0) // Reset về 0 khi đăng nhập đúng
  lockedUntil        DateTime?           // Khoá tạm do sai mật khẩu liên tiếp — tự hết hạn, khác với status
  deletedAt          DateTime?           // Xoá mềm. null = còn hoạt động

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  accounts           Account[]

  @@index([createdAt])
  @@index([roleId])
  @@index([status])
  @@map("users")
}

/**
 * Tài khoản mạng xã hội liên kết (Google/Github/Facebook/Apple).
 *
 * Cố ý KHÔNG lưu access/refresh token của provider: bảng này chỉ phục vụ đăng
 * nhập (xác định "đây là user nào"), không gọi lại API của Google/Github thay
 * mặt người dùng sau đó. Lưu token mà không dùng là giữ một bí mật không cần
 * thiết — nếu sau này cần gọi API thay mặt user thì thêm cột lúc đó.
 */
model Account {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String   // "google" | "github" | "facebook" | "apple"
  providerAccountId String   // id người dùng phía provider (sub/id)
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // SHA-256 hash của token
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime? // Set khi đăng xuất hoặc xoay vòng token
  userAgent String?   // Thiết bị / Trình duyệt
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model VerificationToken {
  id        String                @id @default(cuid())
  tokenHash String                @unique // SHA-256 hash của token
  type      VerificationTokenType
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?             // Set khi token đã được sử dụng
  createdAt DateTime              @default(now())

  @@index([userId, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}
